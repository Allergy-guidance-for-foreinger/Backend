## APP
APP_NAME=mealguide-api
APP_PORT=8080
APP_IMAGE_TAG=latest
POSTGRES_PORT=5432
REDIS_PORT=6379

## DB
DB_HOST=postgres
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

## JPA
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
JPA_HIBERNATE_DDL_AUTO=validate
JPA_FORMAT_SQL=false

## REDIS
REDIS_HOST=redis

## CORS
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

## SWAGGER
SWAGGER_SERVER_URL="https://api.your-domain.com"
SWAGGER_DESCRIPTION="Production API Server"

## JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=

## OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here

## Actuator
ACTUATOR_EXPOSE=health,info,prometheus

## Monitoring
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password

## PYTHON SERVER
MEAL_CRAWL_PYTHON_BASE_URL=

## FIREBASE
MEAL_CRAWL_FIREBASE_ENABLED=false
MEAL_CRAWL_FIREBASE_BUCKET_NAME=your-bucket-name.appspot.com
MEAL_CRAWL_FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
MEAL_CRAWL_FIREBASE_CREDENTIALS_HOST_PATH=./firebase-credentials.json

## Menu image upload limit
MEAL_CRAWL_IMAGE_MAX_FILE_SIZE_BYTES=
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=
MEAL_CRAWL_IMAGE_DAILY_ANALYSIS_LIMIT=

## User Privacy
USER_EMAIL_ENCRYPTION_KEY=
USER_EMAIL_HASH_KEY=
USER_EMAIL_KEY_ID=v1
